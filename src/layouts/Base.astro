---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { url } from "../lib/url";
import cormorantCyr from "../fonts/cormorant-garamond-cyrillic-600-normal.woff2?url";
import oldStandardCyr from "../fonts/old-standard-tt-cyrillic-400-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  overHero?: boolean; // шапка поверх первого экрана (главная)
  form?: boolean; // на странице есть форма
  noindex?: boolean;
}
const { title, description, overHero = false, form = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "") || "/", Astro.site);
const ogImage = new URL("/assets/img/og.jpg", Astro.site);
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex">}
  <link rel="canonical" href={canonical}>
  <meta name="theme-color" content="#0e0c0b">
  <meta name="color-scheme" content="dark">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="ru_RU">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml">
  <link rel="preload" href={cormorantCyr} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={oldStandardCyr} as="font" type="font/woff2" crossorigin>
  <slot name="head" />
  <script is:inline src={url("/assets/js/main.js")} defer></script>
  {form && <script is:inline src={url("/assets/js/form.js")} defer></script>}
  <script is:inline src={url("/assets/js/icons.js")} type="module"></script>
</head>
<body>
  <a class="skip-link" href="#main">Перейти к содержимому</a>
  <Header over={overHero} />
  <main id="main">
    <slot />
  </main>
  <Footer />
</body>
</html>

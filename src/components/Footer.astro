---
import { site, nav } from "../data/site";
import { url } from "../lib/url";
import Logo from "./Logo.astro";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <Logo title="Russian Gothic Club" />
    <div class="site-footer__grid">
      <div>
        <h2>Студия</h2>
        <p>{site.address}</p>
        <p>{site.metro}</p>
        <p>{site.hours}</p>
        <p><a href={`https://t.me/${site.telegram}`} target="_blank" rel="noopener">Telegram @{site.telegram}</a></p>
      </div>
      <div>
        <h2>Разделы</h2>
        <ul>{nav.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}</ul>
      </div>
      <div>
        <h2>Ещё</h2>
        <ul>
          <li><a href={url("/zapis/")}>Записаться на консультацию</a></li>
          <li><a href={url("/privacy/")}>Политика конфиденциальности</a></li>
        </ul>
      </div>
    </div>
    <div class="site-footer__bottom">
      <p>&copy; <span data-year>{year}</span> {site.name}</p>
      <p>Концепт сайта: студия вымышленная, гравюры XIX века из общественного достояния</p>
    </div>
  </div>
</footer>

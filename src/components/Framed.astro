---
// Эскиз на светлой бумаге в резной раме, как картина на тёмной стене
import { frames, type FrameName } from "../data/frames";
import { url } from "../lib/url";
import Bat from "./Bat.astro";
interface Props { frame: FrameName; img?: string; bat?: boolean; alt: string; taken?: boolean }
const { frame, img, bat, alt, taken = false } = Astro.props;
const f = frames[frame];
const [t, r, b, l] = f.opening;
---
<div class="framed" style={`--ratio: ${f.width} / ${f.height}`}>
  <div class="framed__paper" style={`inset: ${t}% ${r}% ${b}% ${l}%`}>
    {bat ? <Bat class="framed__bat" /> : <img src={url(`/assets/img/${img}`)} width="800" height="1000" alt={alt} loading="lazy" decoding="async">}
  </div>
  <img class="framed__frame" src={url(`/assets/img/${f.src}`)} width={f.width} height={f.height} alt="" loading="lazy" decoding="async">
  {taken && <span class="stamp">Занят</span>}
</div>

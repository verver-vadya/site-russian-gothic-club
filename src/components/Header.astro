---
import { nav } from "../data/site";
import { url } from "../lib/url";
import Logo from "./Logo.astro";
interface Props { over?: boolean }
const { over = false } = Astro.props;
// Текущий раздел: адрес страницы начинается с адреса пункта меню
const here = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "") || "/";
const isCurrent = (href: string) => here === href || here.startsWith(href);
---
<header class:list={["site-header", { "site-header--over": over }]}>
  <div class="container site-header__inner">
    <a class="logo" href={url("/")} aria-label="Russian Gothic Club, на главную"><Logo variant="mono" /><span class="logo__sub">тату-студия</span></a>
    <nav id="site-nav" class="site-nav" aria-label="Основное меню">
      <ul>
        {nav.map((item) => (
          <li><a href={url(item.href)} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="button button--small site-header__cta" href={url("/zapis/")}>Записаться</a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <morph-icon size="20" reduced-motion="user"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16M4 12h16M4 19h16"/></svg></morph-icon>
      <span class="nav-toggle__label">Меню</span>
    </button>
  </div>
</header>
